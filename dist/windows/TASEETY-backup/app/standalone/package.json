{
  "name": "school-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "package:windows": "node scripts/package-windows.cjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.school.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.school.config.ts",
    "db:generate:central": "drizzle-kit generate --config src/drizzle.central.config.ts",
    "db:migrate:central": "drizzle-kit migrate --config src/drizzle.central.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.school.config.ts",
    "lint": "eslint .",
    "prestart": "node scripts/migrate-central.cjs",
    "test:migrations": "python tests/test_migration_compatibility.py",
    "predev": "node scripts/migrate-central.cjs",
    "test": "node --test tests/*.test.cjs && python tests/test_migration_compatibility.py && python tests/test_account_lifecycle_migrations.py",
    "test:integration": "node --test tests/account-api-integration.test.cjs && python tests/test_migration_compatibility.py && python tests/test_account_lifecycle_migrations.py"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "adm-zip": "^0.6.1",
    "better-auth": "^1.3.34",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "fontkit": "^2.0.4",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.47.0",
    "next": "^15.5.7",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
  
}
