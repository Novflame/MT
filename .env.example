# Better Auth
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
INTERNAL_REGISTRATION_SECRET=replace-with-a-separate-random-secret

# Optional runtime paths
CENTRAL_DATABASE_PATH=./central.db
SCHOOL_DATABASE_DIR=./databases

# Persistent backup storage (must be included in the deployment volume)
BACKUP_DIRECTORY=./backups

# Scheduled attendance report endpoint; use a random secret of at least 32 characters
DAILY_REPORT_CRON_SECRET=replace-with-a-random-secret-at-least-32-characters
# Persistent school logo uploads (outside the build-time public asset manifest)
SCHOOL_UPLOADS_DIR=./public/uploads

# Optional transactional email (password reset and email verification)
RESEND_API_KEY=
EMAIL_FROM="School System <accounts@example.com>"
